      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(i => {\n  const r = i.json;\n  return { json: {\n    client_id: r.id,\n    client_name: r.name || 'Cliente',\n    act_id: r.meta_ad_account_id || r.act_id || '',\n    slack_channel_id: r.slack_channel_id || '',\n    date_preset: 'last_7d'\n  } };\n}).filter(i => i.json.act_id && i.json.act_id.toString().startsWith('act_'));"
      }
    },
